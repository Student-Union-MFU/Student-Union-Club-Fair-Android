<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay.

  Points the app at the cleartext allow-list in src/debug/res so `make dev` on the
  developer's machine is reachable. A release build never merges this file, so it
  keeps Android's default of refusing plain HTTP entirely — which is what should
  happen, and is easy to lose if the attribute is set in the main manifest and
  then forgotten.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
