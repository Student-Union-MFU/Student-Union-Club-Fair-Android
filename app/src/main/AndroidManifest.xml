<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Everything the app shows now comes from su-server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read, never changed: the offline queue needs to know whether a send is
         worth attempting, and a failed request is a slow way to find out. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The Scan tab reads booth QR codes. Requested at runtime, and the whole
         tab degrades to an explainer if it's refused.
         Still declared not-required: the rest of the app — the club directory,
         the pass, the announcements — works without a camera. Only collecting a
         stamp needs one, and since booth codes rotate there is no longer a typed
         fallback for that. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Removed, not requested.

         `androidx.credentials` — which is how Google sign-in works — depends on
         `androidx.biometric`, and that library declares both of these in its own
         manifest. Nothing in this app calls `BiometricPrompt`, so the merged
         manifest was asking two thousand students for fingerprint access on
         behalf of a code path that does not exist.

         The manifest merger has no idea that; only we do, which is why this has
         to be said explicitly here rather than fixed by an exclusion in Gradle.

         **If a passkey sign-in is ever added, these come back.** Credential
         Manager uses BiometricPrompt to confirm a passkey, and it will fail
         without them — the failure would look like a broken Google button, not
         like a missing permission, so this comment is the trail back. -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <application
        android:name=".ClubFairApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SUClubFair">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SUClubFair">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
