    <!-- The server's `category` tokens, said in words. Also what a zone's
         subtitle is built from — see `zoneIntent`. -->
    <string name="booth_category_sports">Sports</string>
    <string name="booth_category_student_relations">Student relations</string>
    <string name="booth_category_volunteer">Volunteering</string>
    <string name="booth_category_religion_and_culture">Religion &amp; culture</string>
    <string name="booth_category_academic">Academic</string>

    <!--
      PLACEHOLDER booth descriptions, one per category.

      Stand-ins until the Student Union writes `booth.about`, which is empty on
      all 28 rows. Per category and not per club on purpose: the server tells
      the app what kind of club a booth is and nothing more, and a sentence
      invented about a named student society would be a fabrication on the card
      a student uses to choose where to walk. Each line is true of every club in
      its category. Delete these once real copy exists — the server's `about`
      already wins wherever it is filled in.
    -->
    <string name="booth_about_sports">Training, friendly matches and a team that turns up every week. Come and try a session.</string>
    <string name="booth_about_student_relations">The students who run the events, the welcome and the welfare across campus. Ask them how to get involved.</string>
    <string name="booth_about_volunteer">Volunteer work off campus — community, conservation and the trips that go with it.</string>
    <string name="booth_about_religion_and_culture">Faith, tradition and Thai performing arts, kept alive by the students who practise them.</string>
    <string name="booth_about_academic">Debate, performance and competition — clubs that take a skill and enter it into things.</string>
    <string name="booth_about_generic">Come and meet the club at their stall.</string>

    <!-- The Prizes page. The tier names and descriptions are the server's; only
