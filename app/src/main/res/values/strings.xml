    <string name="register_surname_hint">Surname</string>
    <string name="register_email_hint">MFU email</string>
    <!-- Shown under the email once it parses, so the student id the server will
         store is never a surprise. -->
    <string name="register_derived_id">Student ID %1$s</string>
    <string name="register_phone_hint">Phone number</string>
    <string name="register_confirm_hint">Confirm</string>
    <string name="register_school_hint">School</string>
    <string name="register_major_hint">Major</string>
