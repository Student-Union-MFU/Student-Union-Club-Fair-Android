<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launcher label, and the one string that is the app's own name rather
      than copy about it.

      Translatable, unlike before. It used to be "SU Club Fair" and was marked
      untranslatable on the argument that it was the name of the event; "Student
      Union Club Fair" is a description, and องค์การนักศึกษา is the Student Union's
      own Thai name — already used in `logo_su` — so leaving it in English would
      be the only untranslated thing a Thai reader sees on their home screen.
    -->
    <string name="app_name">Student Union Club Fair</string>

    <string name="welcome_title">Club Fair</string>
    <string name="welcome_subtitle">Clubs, booths\n&amp; a weekend\nto explore</string>
    <string name="welcome_drag_hint">Get Started</string>

    <string name="login_title">Log in</string>
    <string name="login_subtitle">Sign in to continue to Club Fair.</string>
    <string name="login_no_account">Don\'t have an account? Sign up</string>
    <string name="login_cta">Login</string>
    <string name="login_working">Signing in…</string>
    <string name="login_or">or</string>
    <string name="login_google">Continue with Google</string>

    <!-- Sign-in failures. Each names the thing to do next; "invalid credentials"
         tells someone nothing about which of the two boxes to look at. -->
    <!-- The server sends its own message for a rejected sign-in; this is only
         the fallback for when it sends none. -->
    <string name="login_error_generic">Couldn\'t sign in. Check your number and password.</string>
    <!-- The one failure the student can act on by moving. -->
    <string name="auth_error_offline">Can\'t reach the server. Check your connection and try again.</string>
    <string name="auth_google_unavailable">Google sign-in isn\'t set up yet — use your phone number and password.</string>
    <!-- The same build problem, on the screen with no fallback to point at:
         sign-up is Google-only, so there is nothing else to suggest. -->
    <string name="auth_google_unavailable_signup">Google sign-in isn\'t set up in this build, so new accounts can\'t be created yet.</string>

    <string name="register_title">Create an Account</string>
    <string name="register_subtitle">Sign up to explore clubs and collect your booth stamps</string>
