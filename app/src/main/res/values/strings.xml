    <string name="register_legal_terms">Terms of Service</string>
    <string name="register_legal_privacy">Privacy Policy</string>

    <!-- The second half of sign-up, shown after Google has created the account
         but before the student has given the details Google cannot supply. -->
    <string name="complete_title">Almost there</string>
    <string name="complete_subtitle">Signed in as %1$s. A few details we can\'t get from Google.</string>
    <string name="complete_student_id">Student ID %1$s</string>
