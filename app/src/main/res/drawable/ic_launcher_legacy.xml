        <path
            android:fillColor="#FFC6F16C"
            android:pathData="M97,68.97L97,61.83L84.65,55.66L84.65,62.54L77.19,67.49L68.95,63.68L68.95,47.72L30.85,28.46L11,38.37L11.04,54.7L22.53,61.1L30.81,57.25L38.5,61.1L38.5,62.76L31.03,67.3L22.87,63.31L11.93,69L30.81,79.79L50.8,69.34L50.8,54.7L30.96,45.17L22.94,48.79L22.94,45.69L30.88,41.32L55.9,53.22L55.9,68.97L76.56,79.76Z" />
