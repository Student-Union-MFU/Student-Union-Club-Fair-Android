    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <clip-path android:pathData="M24,0L84,0A24,24 0 0 1 108,24L108,84A24,24 0 0 1 84,108L24,108A24,24 0 0 1 0,84L0,24A24,24 0 0 1 24,0Z" />
        <!-- Ground. -->
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="-27"
                    android:endX="54" android:endY="135">
                    <item android:offset="0" android:color="#FF0B120E" />
                    <item android:offset="0.58" android:color="#FF080E0B" />
                    <item android:offset="1" android:color="#FF050806" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Lime, off the top-right corner. -->
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="122.04" android:centerY="-17.28"
                    android:gradientRadius="97.2">
                    <item android:offset="0" android:color="#4CA8E065" />
                    <item android:offset="0.45" android:color="#1AA8E065" />
                    <item android:offset="1" android:color="#00A8E065" />
