        <!-- Emerald, filling the left. -->
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="-17.28" android:centerY="28.08"
                    android:gradientRadius="132.84">
                    <item android:offset="0" android:color="#701E7A4E" />
                    <item android:offset="0.45" android:color="#261E7A4E" />
